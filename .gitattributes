# Normalize line endings across the team — store text as LF in the repo,
# check out with each OS's native endings. Prevents whole-file diffs when
# someone commits from a different platform.
* text=auto eol=lf

# Binary assets — never touch their bytes.
*.jpg binary
*.png binary
*.zip binary

# Bundled third-party library: keep it out of the repo's language stats and
# collapse it in diffs. It is a verbatim upstream build, never edited here.
vendor/** linguist-vendored
vendor/** -diff

# Generated by tools/build.py — collapse it in diffs and reviews so the real
# changes in js/ stay readable.
Desperation-singlefile.html linguist-generated
